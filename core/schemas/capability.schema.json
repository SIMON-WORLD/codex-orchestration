{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability.schema.json",
  "title": "Capability（v1.3 最终）",
  "type": "object",
  "description": "能力：具体能做什么 + 质量状态 + 风险 + 要求。environment_requirements 只允许在 implementation 层；未明确字段默认拒绝。",
  "properties": {
    "id": { "type": "string", "description": "命名空间化，如 <domain>.<category>.<capability>" },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "methodology": { "type": "object", "required": ["references"], "properties": { "references": { "type": "array" }, "note": { "type": "string" } } },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "runtime", "verification_status", "environment_requirements", "verification"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["tool", "skill", "workflow", "script"] },
          "runtime": { "type": "string", "description": "该实现自身的 runtime（如 python/r/stata/any）；不设永久 preferred_runtime" },
          "verification_status": { "enum": ["reference", "experimental", "tested", "verified", "deprecated"] },
          "environment_requirements": {
            "type": "object",
            "properties": {
              "runtime": { "type": "string" },
              "version_constraints": { "type": "string" },
              "packages": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          },
          "verification": {
            "type": "object",
            "required": ["evidence", "benchmark_ref"],
            "properties": { "evidence": { "type": ["string", "null"] }, "benchmark_ref": { "type": ["string", "null"] } }
          }
        }
      }
    },
    "scientific_preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "machine 用 field/required_value/on_missing/on_mismatch；manual 用 label",
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["machine", "manual"] },
          "field": { "type": "string" },
          "required_value": {},
          "on_missing": { "enum": ["needs_decision", "blocked"] },
          "on_mismatch": { "enum": ["needs_decision", "blocked"] },
          "label": { "type": "string" }
        },
        "oneOf": [
          { "properties": { "kind": { "const": "machine" }, "field": { "type": "string" }, "required_value": {} }, "required": ["field", "required_value"] },
          { "properties": { "kind": { "const": "manual" }, "label": { "type": "string" } }, "required": ["label"] }
        ]
      }
    },
    "decision_requirements": { "type": "array", "items": { "type": "string" } },
    "fallback_policy": { "enum": ["allow", "recorded", "needs_decision", "hard_stop"] }
  },
  "required": ["id", "domain", "description", "risk_level", "methodology", "implementations", "fallback_policy"],
  "not": { "required": ["environment_requirements", "maturity"] }
}
