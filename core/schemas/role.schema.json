{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role.schema.json",
  "title": "Role（v1.3 目标结构）",
  "type": "object",
  "description": "角色：谁负责 + 需要哪些能力 + 产出什么。Skeleton；v1.2 的 methodology/toolchain/journal/policy 为待弃用字段（compat wrapper 映射）。",
  "properties": {
    "id": { "type": "string" },
    "domain": { "type": "string" },
    "name": { "type": "string" },
    "responsibility": { "type": "string" },
    "authority": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "capability_scope": { "type": "array", "items": { "type": "string" }, "description": "本角色能承担的能力类型（可含 * 通配前缀）" },
    "selected_capabilities": { "type": "array", "items": { "type": "string" }, "description": "某次研究的动态选择（在 plan 级，不在 role 级）" },
    "required_capabilities": { "type": "array", "items": { "type": "string" }, "deprecated": true, "description": "已废弃：静态要求所有方法会误阻塞；改用 capability_scope + 引擎级 selected_capabilities" },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "target": { "enum": ["projectless", "project", "chatgptWorkCloud"] },
    "escalation_rules": { "type": "array", "items": { "type": "string" } },
    "methodology": { "type": "object", "deprecated": true, "description": "v1.2；迁移到 capability registry" },
    "toolchain": { "type": "string", "deprecated": true, "description": "v1.2；迁到 run-level execution_context" },
    "journal": { "type": "string", "deprecated": true, "description": "v1.2；迁到 execution_context.target_journal" },
    "policy": { "type": "object", "deprecated": true, "description": "v1.2；迁到 risk/fallback policy" },
    "evidence_grading": { "type": "boolean", "deprecated": true }
  },
  "required": ["id", "name", "prompt", "capability_scope"]
}
