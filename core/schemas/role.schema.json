{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role.schema.json",
  "title": "Role（v1.3）",
  "type": "object",
  "description": "角色：responsibility + authority + inputs/outputs + capability_scope + escalation。科研方法由 selected_capabilities → registry → resolver 决定。v1.2 的 prompt/methodology/toolchain/journal/policy 为待弃用字段（compat wrapper 映射）。",
  "properties": {
    "id": { "type": "string" },
    "domain": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "responsibility": { "type": "array", "items": { "type": "string" }, "description": "该角色负责做什么" },
    "authority": {
      "type": "object",
      "properties": {
        "may_decide": { "type": "array", "items": { "type": "string" } },
        "must_escalate": { "type": "array", "items": { "type": "string" }, "description": "无权自行决定，必须上报" }
      }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "capability_scope": { "type": "array", "items": { "type": "string" }, "description": "允许承担的能力范围（含 * 通配）；不是每次都需要执行的范围" },
    "selected_capabilities": { "type": "array", "items": { "type": "string" }, "deprecated": true, "description": "某次研究的动态选择，在 study 级（不在 role 级）" },
    "required_capabilities": { "type": "array", "items": { "type": "string" }, "deprecated": true },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "target": { "enum": ["projectless", "project", "chatgptWorkCloud"] },
    "escalation_rules": { "type": "array", "items": { "type": "string" } },
    "prompt": { "type": "string", "deprecated": true, "description": "v1.2 自包含 prompt；v1.3 由 scaffold 从 responsibility/authority + selected capabilities 生成" },
    "methodology": { "type": "object", "deprecated": true },
    "toolchain": { "type": "string", "deprecated": true },
    "journal": { "type": "string", "deprecated": true },
    "policy": { "type": "object", "deprecated": true },
    "evidence_grading": { "type": "boolean", "deprecated": true }
  },
  "required": ["id", "name", "responsibility", "authority", "capability_scope"]
}
