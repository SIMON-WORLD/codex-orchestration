{ "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"artifact.data.schema.json", "title":"Data-side artifacts（顶层，按 artifact_type 区分）", "type":"object", "$defs":{
 "common":{ "type":"object", "required":["artifact_id","artifact_type","schema_version","producer_role","producer_task_id"], "properties":{ "artifact_id":{"type":"string"}, "artifact_type":{"type":"string"}, "schema_version":{"type":"string"}, "producer_role":{"type":"string"}, "producer_task_id":{"type":"string"}, "created_at":{"type":"string"}, "inputs":{"type":"array","items":{"type":"string"}}, "code_ref":{"type":"string"}, "data_ref":{"type":"string"} } },
 "data_manifest":{ "type":"object", "allOf":[{"$ref":"#/$defs/common"}], "required":["dataset_id","observation_count","variable_count"], "properties":{ "dataset_id":{"type":"string"}, "observation_count":{"type":"integer"}, "variable_count":{"type":"integer"}, "dataset_sha256":{"type":["string","null"]}, "source_refs":{"type":"array"}, "parent_dataset_refs":{"type":"array"} } },
 "variable_dictionary":{ "type":"object", "allOf":[{"$ref":"#/$defs/common"}], "required":["variables"], "properties":{ "variables":{"type":"array","items":{"type":"object","required":["name","definition"],"properties":{"name":{"type":"string"},"definition":{"type":"string"},"type":{"type":"string"},"unit":{"type":"string"},"source":{"type":"string"},"construction_ref":{"type":"string"}}}} } },
 "sample_flow":{ "type":"object", "allOf":[{"$ref":"#/$defs/common"}], "required":["steps"], "properties":{ "steps":{"type":"array","items":{"type":"object","required":["step_id","n_before","n_after","n_removed","reason"],"properties":{"step_id":{"type":"string"},"n_before":{"type":"integer"},"n_after":{"type":"integer"},"n_removed":{"type":"integer"},"reason":{"type":"string"}}}} } },
 "descriptive_facts":{ "type":"object", "allOf":[{"$ref":"#/$defs/common"}], "required":["facts"], "properties":{ "facts":{"type":"array","items":{"type":"object","required":["fact_id","name","value"],"properties":{"fact_id":{"type":"string"},"name":{"type":"string"},"value":{},"unit":{"type":"string"},"sample_id":{"type":"string"},"source_data_ref":{"type":"string"},"computation_ref":{"type":"string"}}}} } }
},
 "oneOf":[
  {"properties":{"artifact_type":{"const":"data_manifest"},"observation_count":{"type":"integer"},"variable_count":{"type":"integer"}},"required":["artifact_type","dataset_id","observation_count","variable_count"]},
  {"properties":{"artifact_type":{"const":"variable_dictionary"},"variables":{"type":"array"}},"required":["artifact_type","variables"]},
  {"properties":{"artifact_type":{"const":"sample_flow"},"steps":{"type":"array"}},"required":["artifact_type","steps"]},
  {"properties":{"artifact_type":{"const":"descriptive_facts"},"facts":{"type":"array"}},"required":["artifact_type","facts"]}
 ] }
