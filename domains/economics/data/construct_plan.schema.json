{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SIMON-WORLD/codex-orchestration/blob/main/domains/economics/data/construct_plan.schema.json",
  "title": "Economics construct plan contract v1",
  "description": "Domain-level construct transformation plan. NOT a Core public artifact schema. Declarative, safe, structured expression spec (NO arbitrary eval / arbitrary expression execution). Each operation is an explicitly enumerated kind with structured args. It NEVER autonomously decides the final estimation sample: it may only compute an explicitly defined indicator/eligibility FLAG; using that flag to define the sample is a Director/study-design decision.",
  "type": "object",
  "required": ["schema_version", "plan_id", "input", "output", "operations"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "plan_id": { "type": "string", "minLength": 1 },
    "input": { "type": "object", "required": ["dataset_id", "file", "columns"], "properties": { "dataset_id": { "type": "string" }, "file": { "type": "string" }, "sha256": { "type": ["string", "null"] }, "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "output": { "type": "object", "required": ["dataset_id", "file"], "properties": { "dataset_id": { "type": "string" }, "file": { "type": "string" }, "sort_by": { "type": "array", "items": { "type": "string" } } } },
    "unit_of_analysis": { "type": ["string", "null"] }, "scientific_bindings": { "type": "object", "description": "Optional approved scientific-decision bindings keyed by constructed target. Any op declaring scientific_role requires a matching binding with approved=true and a decision_ref.", "additionalProperties": { "type": "object", "required": ["role", "decision_ref", "approved"], "properties": { "role": { "type": "string" }, "decision_ref": { "type": "string" }, "approved": { "type": "boolean" } } } },
    "panel_by": { "type": ["string", "null"], "description": "Panel id column used by lag/lead/difference/growth when needed." },
    "time_by": { "type": ["string", "null"], "description": "Time column used by lag/lead/difference/growth when needed." },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/op" } }
  },
  "$defs": {
    "opBase": { "type": "object", "required": ["op_id", "kind"], "properties": { "op_id": { "type": "string", "minLength": 1 }, "kind": { "type": "string" }, "scientific_role": { "type": "string" } } },
    "arithmetic": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "arithmetic" }, "operator": { "type": "string", "enum": ["add", "subtract", "multiply", "divide"] }, "left": { "type": ["string", "number"] }, "right": { "type": ["string", "number"] }, "target": { "type": "string" } },
      "required": ["operator", "left", "right", "target"]
    },
    "log": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "log" }, "source": { "type": "string" }, "target": { "type": "string" }, "base": { "type": "string", "enum": ["natural", "10"] } },
      "required": ["source", "target"]
    },
    "ratio": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "ratio" }, "numerator": { "type": "string" }, "denominator": { "type": "string" }, "target": { "type": "string" } },
      "required": ["numerator", "denominator", "target"]
    },
    "difference": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "difference" }, "source": { "type": "string" }, "target": { "type": "string" }, "periods": { "type": "integer", "minimum": 1 } },
      "required": ["source", "target"]
    },
    "growth_rate": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "growth_rate" }, "source": { "type": "string" }, "target": { "type": "string" }, "periods": { "type": "integer", "minimum": 1 } },
      "required": ["source", "target"]
    },
    "interaction": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "interaction" }, "terms": { "type": "array", "items": { "type": "string" }, "minItems": 2 }, "target": { "type": "string" } },
      "required": ["terms", "target"]
    },
    "lag": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "lag" }, "source": { "type": "string" }, "target": { "type": "string" }, "periods": { "type": "integer", "minimum": 1 }, "panel_by": { "type": "string" }, "time_by": { "type": "string" } },
      "required": ["source", "target"]
    },
    "lead": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "lead" }, "source": { "type": "string" }, "target": { "type": "string" }, "periods": { "type": "integer", "minimum": 1 }, "panel_by": { "type": "string" }, "time_by": { "type": "string" } },
      "required": ["source", "target"]
    },
    "indicator": {
      "allOf": [{ "$ref": "#/$defs/opBase" }],
      "properties": { "kind": { "const": "indicator" }, "target": { "type": "string" }, "predicate": { "$ref": "#/$defs/predicate" } },
      "required": ["target", "predicate"]
    },
    "predicate": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "type": "string", "enum": ["gt", "gte", "lt", "lte", "eq", "neq", "and", "or"] },
        "left": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "$ref": "#/$defs/predicate" }] },
        "right": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "$ref": "#/$defs/predicate" }] },
        "args": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/predicate" } }
      }
    },
    "op": {
      "oneOf": [
        { "$ref": "#/$defs/arithmetic" }, { "$ref": "#/$defs/log" }, { "$ref": "#/$defs/ratio" },
        { "$ref": "#/$defs/difference" }, { "$ref": "#/$defs/growth_rate" }, { "$ref": "#/$defs/interaction" },
        { "$ref": "#/$defs/lag" }, { "$ref": "#/$defs/lead" }, { "$ref": "#/$defs/indicator" }
      ]
    }
  }
}
